<Window x:Class="backtest.AjoutTrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Ajouter un Trade" Height="750" Width="500" 
        Background="#0A0A12" WindowStyle="None" AllowsTransparency="True" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="NeonPulseAnimation">
            <DoubleAnimation Storyboard.TargetName="OuterRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="InnerRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="ModernField" TargetType="TextBox">
            <Setter Property="Background" Value="#121220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#252540"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource NeonPulseAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="15">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="AJOUTER" FontSize="10" Foreground="{StaticResource AccentBlue}" />
                    <TextBlock Text="NOUVEAU TRADE" FontSize="22" FontWeight="Black" Foreground="White"/>
                </StackPanel>

                <Grid HorizontalAlignment="Right" Width="50" Height="50">
                    <Ellipse Stroke="{StaticResource AccentBlue}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OuterRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Stroke="{StaticResource NeonPink}" StrokeThickness="3" Margin="8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="InnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="GlowEffect" BlurRadius="15" ShadowDepth="0" Color="Pink"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="MainStack">
                    <TextBlock Text="CONFIG DU TRADE" FontSize="10" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,10,0,10"/>

                    <TextBlock Text="PAIRE" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="PaireTextBox" Style="{StaticResource ModernField}" Height="35" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="TYPE" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                            <ComboBox x:Name="TypeOrdreComboBox" Height="35"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="RÉSULTAT" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ResultComboBox" Height="35"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="ENTRÉE (DATE/HEURE)" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DateEntreePicker" Margin="0,0,0,5"/>
                            <xctk:TimePicker x:Name="TimeEntreePicker" Background="#121220" Foreground="White" BorderBrush="#252540"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="SORTIE (DATE/HEURE)" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DateSortiePicker" Margin="0,0,0,5"/>
                            <xctk:TimePicker x:Name="TimeSortiePicker" Background="#121220" Foreground="White" BorderBrush="#252540"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="RISK REWARD (RR)" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="RrTextBox" Style="{StaticResource ModernField}" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="CAPTURES D'ÉCRAN (LIENS HTF,LTF)" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImageLtfTextBox" Style="{StaticResource ModernField}" Height="35" Margin="0,0,5,0"/>
                        <TextBox x:Name="ImageHtfTextBox" Grid.Column="1" Style="{StaticResource ModernField}" Height="35" Margin="5,0,0,0"/>
                    </Grid>

                    <StackPanel Name="stackprofit">
                        <TextBlock Text="PROFIT/PERTE ex: 100, -100, 0" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="profitTxt" Style="{StaticResource ModernField}" Height="35" Margin="0,0,0,15"/>
                    </StackPanel>
                    <TextBlock Text="NOTES / DESCRIPTION" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="descriptionTextbox" Height="60" Style="{StaticResource ModernField}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <TextBlock Text="CONFLUENCES &amp; CRITÈRES" FontSize="10" Foreground="{StaticResource NeonPink}" FontWeight="Bold" Margin="0,10,0,10"/>
                    <StackPanel x:Name="DynamicFieldsPanel"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="texetat" 
           Text="TRADE ENREGISTRÉ AVEC SUCCÈS !" 
           FontSize="10" 
           Foreground="#0EFF22" 
           HorizontalAlignment="Center" 
           Margin="0,10,0,0" 
           Visibility="Collapsed" 
           Grid.Row="1" 
           VerticalAlignment="Bottom"/>

            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
            </UniformGrid>
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
                <Button Content="ANNULER" Click="Cancel_Click" Margin="0,0,10,0" Height="40" Background="#1A1A2E" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="ENREGISTRER" Click="SaveTrade_Click" Height="40" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>