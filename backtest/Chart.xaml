<UserControl x:Class="backtest.Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Background="#0B0E11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <!-- La largeur est en Auto pour s'adapter au contenu du Tab (Watchlist étroite ou Formulaire large) -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Barre de navigation haute (Inchangée) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#131722" BorderBrush="#2A2E39" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock x:Name="TxtCurrentSymbol" Text="EURUSD" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                <Rectangle Width="1" Fill="#2A2E39" Margin="10,8"/>

                <ItemsControl x:Name="TimeframeSelector" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Click="Timeframe_Click" Tag="{Binding Value}" Margin="2,0" Padding="8,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TFButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#2962FF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Width="1" Fill="#2A2E39" Margin="10,8"/>
            </StackPanel>
        </Border>

        <!-- Zone Graphique -->
        <wv2:WebView2 x:Name="ChartBrowser" Grid.Row="1" Grid.Column="1" />

        <!-- Colonne Latérale avec Onglets -->
        <Border Grid.Row="1" Grid.Column="2" Background="#131722" BorderBrush="#2A2E39" BorderThickness="1,0,0,0">
            <TabControl Name="MaintabControl" Background="Transparent" BorderThickness="0">
                <!-- Onglet Watchlist (Largeur compacte) -->
                <TabItem Header="LIST"  >
                    <Grid Width="87">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="WATCHLIST" Foreground="Gray" FontSize="10" Margin="5,10,0,5" FontWeight="Bold"/>
                        <ListBox x:Name="WatchlistItems" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="2" SelectionChanged="Watchlist_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <TextBlock Text="{Binding Symbol}" Foreground="White" FontSize="10"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Onglet Ajout Trade (Largeur optimisée pour le formulaire) -->
                <TabItem Header="TRADE">
                    <Grid Width="250">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- En-tête Titre -->
                            <RowDefinition Height="*"/>
                            <!-- Formulaire Scrollable -->
                            <RowDefinition Height="Auto"/>
                            <!-- Bouton Enregistrer -->
                        </Grid.RowDefinitions>

                        <!-- Titre Dynamique (Affiche la stratégie active) -->
                        <StackPanel Grid.Row="0" Margin="10,10,10,5">
                            <TextBlock x:Name="ActionTitle" Text="AJOUTER" HorizontalAlignment="Center" FontSize="9" Foreground="#2962FF" FontWeight="Bold"/>
                            <TextBlock x:Name="MainTitle" Text="NOUVEAU TRADE" HorizontalAlignment="Center" FontSize="13" FontWeight="Black" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <Separator Background="#252540" Margin="0,5,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,5,10,10">

                                <!-- Paire -->
                                <TextBlock Text="PAIRE" FontSize="9" Foreground="Gray"/>
                                <TextBox x:Name="PaireTextBox" Style="{StaticResource ModernField}" Height="28" Margin="0,2,0,8"/>

                                <!-- Type et Résultat -->
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,2,0">
                                        <TextBlock Text="TYPE" FontSize="9" Foreground="Gray"/>
                                        <ComboBox x:Name="TypeOrdreComboBox" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="RÉSULTAT" FontSize="9" Foreground="Gray"/>
                                        <ComboBox x:Name="ResultComboBox" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Prix Entrée et Sortie -->
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,2,0">
                                        <TextBlock Text="PRIX ENTRÉE" FontSize="9" Foreground="Gray"/>
                                        <TextBox x:Name="EntryPriceTxt" Style="{StaticResource ModernField}" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="PRIX SORTIE" FontSize="9" Foreground="Gray"/>
                                        <TextBox x:Name="ExitPriceTxt" Style="{StaticResource ModernField}" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Section ENTRÉE (Date + Heure) -->
                                <TextBlock Text="ENTRÉE" FontSize="9" Foreground="#2962FF" FontWeight="Bold" Margin="0,5,0,2"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <DatePicker x:Name="DateEntreePicker" Margin="0,0,2,0"/>
                                    <xctk:TimePicker x:Name="TimeEntreePicker" Format="Custom" FormatString="HH:mm" 
                                     Background="#121220" Foreground="White" BorderBrush="#252540" Margin="2,0,0,0"/>
                                </UniformGrid>

                                <!-- Section SORTIE (Date + Heure) -->
                                <TextBlock Text="SORTIE" FontSize="9" Foreground="#FF2962" FontWeight="Bold" Margin="0,8,0,2"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <DatePicker x:Name="DateSortiePicker" Margin="0,0,2,0"/>
                                    <xctk:TimePicker x:Name="TimeSortiePicker" Format="Custom" FormatString="HH:mm" 
                                     Background="#121220" Foreground="White" BorderBrush="#252540" Margin="2,0,0,0"/>
                                </UniformGrid>

                                <!-- RR et Profit -->
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,2,0">
                                        <TextBlock Text="RISK REWARD" FontSize="9" Foreground="Gray"/>
                                        <TextBox x:Name="RrTextBox" Style="{StaticResource ModernField}" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="2,0,0,0">
                                        <TextBlock Text="PROFIT / PERTE" FontSize="9" Foreground="Gray"/>
                                        <TextBox x:Name="profitTxt" Style="{StaticResource ModernField}" Height="28" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Zone Dynamique pour les Stratégies -->
                                <TextBlock Text="CONFLUENCES" FontSize="10" Foreground="DeepPink" FontWeight="Bold" Margin="0,10,0,5"/>
                                <StackPanel x:Name="DynamicFieldsPanel"/>

                                <!-- Notes -->
                                <TextBlock Text="NOTES" FontSize="9" Foreground="Gray" Margin="0,8,0,2"/>
                                <TextBox x:Name="descriptionTextbox" Height="50" Style="{StaticResource ModernField}" 
                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bouton d'action -->
                        <Button Grid.Row="2" Content="ENREGISTRER LE TRADE" Click="SaveTrade_Click"
                Background="#2962FF" Foreground="White" Height="35" FontWeight="Bold" Margin="10,5">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Footer (Inchangé) -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#131722" BorderBrush="#2A2E39" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1013*"/>
                    <ColumnDefinition Width="167*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                    <TextBlock x:Name="TxtStatus" Text="Connecté" Foreground="LightGreen" VerticalAlignment="Center" FontSize="10"/>
                </StackPanel>
                <TextBlock Text="DATAEDGE ENGINE v1.0" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" Grid.Column="1" Margin="0,8,-1,7"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>