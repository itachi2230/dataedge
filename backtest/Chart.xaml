<UserControl x:Class="backtest.Chart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid Background="#0B0E11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition/> 
            <ColumnDefinition Width="138"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#131722" BorderBrush="#2A2E39" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock x:Name="TxtCurrentSymbol" Text="EURUSD" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
                <Rectangle Width="1" Fill="#2A2E39" Margin="10,8"/>

                <ItemsControl x:Name="TimeframeSelector" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" 
                    Click="Timeframe_Click" 
                    Tag="{Binding Value}"
                    Margin="2,0"
                    Padding="8,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TFButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#2962FF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Fill="#2A2E39" Margin="10,8"/>
            </StackPanel>
        </Border>

        <wv2:WebView2 x:Name="ChartBrowser" Grid.Row="1" Grid.Column="1" />
        <Border Grid.Row="1" Grid.Column="2" Background="#131722" BorderBrush="#2A2E39" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="WATCHLIST" Foreground="Gray" FontSize="11" Margin="15,15,15,5" FontWeight="Bold"/>

                <ListBox x:Name="WatchlistItems" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="5" SelectionChanged="Watchlist_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="220" Margin="0,5">
                                <TextBlock Text="{Binding Symbol}" Foreground="White" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Price}" Foreground="LightGreen" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#131722" BorderBrush="#2A2E39" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStatus" Text="Connecté" Foreground="LightGreen" VerticalAlignment="Center" FontSize="10"/>
                </StackPanel>
                <TextBlock Text="DATAEDGE ENGINE v1.0" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>