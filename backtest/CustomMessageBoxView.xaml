<Window x:Class="backtest.CustomMessageBoxView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="Auto" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="1"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="MsgBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock x:Name="TitleTextBlock" Foreground="#007ACC" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20" Orientation="Horizontal">
            <Viewbox Width="32" Height="32" Margin="0,0,15,0" VerticalAlignment="Top">
                <Path x:Name="IconPath" Fill="#007ACC" Data=""/>
            </Viewbox>

            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Foreground="White" 
                       FontSize="13" Width="300" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#2D2D30" Padding="10">
            <StackPanel x:Name="ButtonContainer" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnYes" Content="Oui" Style="{StaticResource MsgBtnStyle}" Click="Btn_Click" Tag="Yes" Visibility="Collapsed"/>
                <Button x:Name="BtnNo" Content="Non" Style="{StaticResource MsgBtnStyle}" Click="Btn_Click" Tag="No" Visibility="Collapsed"/>
                <Button x:Name="BtnOk" Content="OK" Style="{StaticResource MsgBtnStyle}" Click="Btn_Click" Tag="OK" Visibility="Collapsed"/>
                <Button x:Name="BtnCancel" Content="Annuler" Style="{StaticResource MsgBtnStyle}" Click="Btn_Click" Tag="Cancel" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>