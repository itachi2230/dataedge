<Window x:Class="backtest.Demo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue sur DataEdge"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Height="520" Width="860"
        Icon="cf-flow-2rapArajcTSXxgLa8IS4fim2Rx2 (1).ico">

    <Window.Resources>
        <!-- Storyboard pour l'animation d'entrée des slides -->
        <Storyboard x:Key="SlideInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Style pour les boutons de navigation cyber -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00BFFF"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1500BFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00BFFF" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00BFFF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#333"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour le bouton Skip -->
        <Style x:Key="SkipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style pour les points de navigation -->
        <Style x:Key="DotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#333"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Grid MouseDown="Window_MouseDown">
        <!-- Fond principal avec bordure néon -->
        <Border CornerRadius="24" BorderThickness="1.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00BFFF" Offset="0"/>
                    <GradientStop Color="#003366" Offset="0.5"/>
                    <GradientStop Color="#00BFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0D141D" Offset="0"/>
                    <GradientStop Color="#FF0A1017" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#00BFFF" Opacity="0.15"/>
            </Border.Effect>
        </Border>

        <!-- Contenu principal -->
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barre supérieure : Logo + Skip -->
            <Grid Grid.Row="0" Height="50" Margin="25,15,25,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DATA" Foreground="White" FontWeight="Black" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="EDGE" Foreground="#00FF03" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="SkipButton" 
                        Content="PASSER LA PRÉSENTATION →" 
                        Style="{StaticResource SkipButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Skip_Click"/>
            </Grid>

            <!-- Conteneur du slide avec animation -->
            <Grid x:Name="SlideContainer" Grid.Row="1" Margin="60,10,60,0">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Grid.RenderTransform>

                <!-- SLIDE 1 : Backtesting -->
                <Grid x:Name="Slide1" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="30"/>
                    </Grid.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Icône/Illustration -->
                        <Border Width="80" Height="80" CornerRadius="40" 
                                Background="#0A1A2E" 
                                BorderBrush="#00BFFF" BorderThickness="1.5"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="📊" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Transformez vos idées de trading" 
                                   Foreground="White" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"/>
                        <TextBlock Text="en stratégies gagnantes" 
                                   Foreground="#00BFFF" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"
                                   Margin="0,0,0,20"/>

                        <Border Height="2" Width="60" Background="#00BFFF" HorizontalAlignment="Center" Margin="0,0,0,25" Opacity="0.5"/>

                        <TextBlock Text="Découvrez les points faibles et les points forts de votre stratégie" 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                        <TextBlock Text="grâce au pouvoir du backtesting." 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 2 : Planning & Habits -->
                <Grid x:Name="Slide2" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="30"/>
                    </Grid.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="40" 
                                Background="#0A1A2E" 
                                BorderBrush="#00BFFF" BorderThickness="1.5"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Planifiez votre semaine de trading" 
                                   Foreground="White" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"/>
                        <TextBlock Text="en avance et contrôlez vos habitudes" 
                                   Foreground="#00BFFF" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"
                                   Margin="0,0,0,20"/>

                        <Border Height="2" Width="60" Background="#00BFFF" HorizontalAlignment="Center" Margin="0,0,0,25" Opacity="0.5"/>

                        <TextBlock Text="Ce n'est pas vous contre le marché," 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                        <TextBlock Text="c'est juste vous." 
                                   Foreground="#00BFFF" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 3 : Trading Psychology -->
                <Grid x:Name="Slide3" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="30"/>
                    </Grid.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="40" 
                                Background="#0A1A2E" 
                                BorderBrush="#00BFFF" BorderThickness="1.5"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00BFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="🧠" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Ne vous laissez pas guider" 
                                   Foreground="White" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"/>
                        <TextBlock Text="par vos émotions" 
                                   Foreground="#00BFFF" 
                                   FontSize="28" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="36"
                                   Margin="0,0,0,20"/>

                        <Border Height="2" Width="60" Background="#00BFFF" HorizontalAlignment="Center" Margin="0,0,0,25" Opacity="0.5"/>

                        <TextBlock Text="Mark DOUGLAS. ''Tu ne peux pas contrôler le prochain mouvement du marché." 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                        <TextBlock Text="Tu peux juste contrôler tes décisions face au marché.''" 
                                   Foreground="#00BFFF" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 4 : Final / Get Started -->
                <Grid x:Name="Slide4" Opacity="0" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="30"/>
                    </Grid.RenderTransform>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="90" Height="90" CornerRadius="45" 
                                Background="#0A1A2E" 
                                BorderBrush="#00FF03" BorderThickness="2"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF03" BlurRadius="25" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="🚀" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Prêt à passer à l'action ?" 
                                   Foreground="White" 
                                   FontSize="30" 
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   LineHeight="40"
                                   Margin="0,0,0,15"/>

                        <Border Height="2" Width="60" Background="#00FF03" HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0.5"/>

                        <TextBlock Text="DataEdge est maintenant prêt à être utilisé." 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                        <TextBlock Text="Commencez par ajouter votre première stratégie de trading." 
                                   Foreground="#999" 
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="24"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Indicateurs de progression (dots) -->
            <StackPanel Grid.Row="2" x:Name="DotsPanel" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,10,0,15">
                <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#00BFFF" Stroke="#00BFFF" StrokeThickness="1" Margin="4,0"/>
                <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#333" Stroke="#555" StrokeThickness="1" Margin="4,0"/>
                <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#333" Stroke="#555" StrokeThickness="1" Margin="4,0"/>
                <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#333" Stroke="#555" StrokeThickness="1" Margin="4,0"/>
            </StackPanel>

            <!-- Barre de navigation inférieure -->
            <Grid Grid.Row="3" Margin="30,0,30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bouton Précédent -->
                <Button x:Name="PreviousBtn" 
                        Grid.Column="0"
                        Content="← PRÉCÉDENT" 
                        Style="{StaticResource NavButtonStyle}"
                        Click="Previous_Click"
                        IsEnabled="False"/>

                <!-- Bouton Suivant / Terminer -->
                <Button x:Name="NextBtn" 
                        Grid.Column="2"
                        Content="SUIVANT →" 
                        Style="{StaticResource NavButtonStyle}"
                        Click="Next_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>