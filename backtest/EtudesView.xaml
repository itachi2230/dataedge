<UserControl x:Class="backtest.EtudesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:backtest"
             mc:Ignorable="d" Margin="15,0,20,0"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Palette du module (évite les hexadécimaux en dur) -->
        <SolidColorBrush x:Key="StudiesPanelBg" Color="#0D141D"/>
        <SolidColorBrush x:Key="StudiesEditorBg" Color="#0A0A12"/>
        <SolidColorBrush x:Key="StudiesToolbarBg" Color="#101827"/>
        <SolidColorBrush x:Key="StudiesBorder" Color="#1F2A3A"/>
        <SolidColorBrush x:Key="StudiesAccent" Color="#00AEEF"/>
        <SolidColorBrush x:Key="StudiesButtonBg" Color="#154B7C"/>
        <SolidColorBrush x:Key="StudiesFormatBg" Color="#1A477A"/>
        <SolidColorBrush x:Key="StudiesRadicalBg" Color="#0F1622"/>

        <ContextMenu x:Key="StudiesContextMenu">
            <MenuItem Header="✏️ Renommer" Click="Rename_Click" />
            <Separator/>
            <MenuItem Header="🗑️ Supprimer" Click="Delete_Click" />
            <Separator/>
            <MenuItem Header="💾 Sauvegarder" Click="SaveStudy_Click" />
            <MenuItem Header="📄 Exporter PDF ou imprimer" Click="ExportRTF_Click" />
        </ContextMenu>

        <Style TargetType="TreeViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource StudiesContextMenu}"/>
        </Style>

        <Style x:Key="ToolActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource StudiesButtonBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudiesAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource StudiesAccent}"/>
                                <Setter Property="Foreground" Value="#061A34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolFormatButton" TargetType="Button" BasedOn="{StaticResource ToolActionButton}">
            <Setter Property="Background" Value="{StaticResource StudiesFormatBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource StudiesBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="96"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <DockPanel Grid.Row="0" Background="{StaticResource StudiesPanelBg}">
                <Button Style="{StaticResource CircleNavButton}" Content="&#xE72B;"
                        FontFamily="Segoe MDL2 Assets" Click="BtnRetour_Click"
                        ToolTip="Retour au Dashboard" Width="36" Height="34" Margin="2,0,0,0"/>
                <TextBlock Text="GESTION DES ÉTUDES" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="White" Opacity="0.9"/>
                <TextBlock x:Name="StudiesCountText" Text="0 étude" FontSize="11"
                           Foreground="{StaticResource StudiesAccent}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,14,0" DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- ===== TOOLBAR ===== -->
            <Border Grid.Row="1" Background="{StaticResource StudiesToolbarBg}"
                    BorderBrush="{StaticResource StudiesBorder}" BorderThickness="0,1" Padding="10,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Actions document -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Nouvelle étude" Style="{StaticResource ToolActionButton}"
                                ToolTip="Créer un nouveau document d'analyse" Click="NewStudy_Click"/>
                        <Button Content="📁 Dossier" Style="{StaticResource ToolActionButton}"
                                ToolTip="Créer un dossier pour ranger les analyses" Click="NewFolder_Click"/>
                        <Rectangle Width="1" Fill="{StaticResource StudiesBorder}" Margin="10,3"/>
                        <Button Content="💾 Enregistrer" Style="{StaticResource ToolActionButton}"
                                ToolTip="Enregistrer l'étude courante" Click="SaveStudy_Click"/>
                        <Button Content="🖨️ PDF" Style="{StaticResource ToolActionButton}"
                                ToolTip="Imprimer ou exporter en PDF" Click="ExportRTF_Click"/>
                        <Button Content="🔄 Migrer .rtf" Style="{StaticResource ToolActionButton}"
                                ToolTip="Convertir les anciens fichiers .rtf vers .etude" Click="Button_Click"/>
                        <TextBlock x:Name="StudiesTitle" Text="Aucun fichier sélectionné" FontSize="11"
                                   FontStyle="Italic" Foreground="#80AEEF" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>

                    <!-- Formatage -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
                        <ComboBox x:Name="FontSizeComboBox" Width="58" SelectedIndex="2"
                                  SelectionChanged="FontSize_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="24"/>
                            <ComboBoxItem Content="36"/>
                        </ComboBox>
                        <Rectangle Width="1" Fill="{StaticResource StudiesBorder}" Margin="10,3"/>

                        <Button Content="G" FontWeight="Bold" Style="{StaticResource ToolFormatButton}" ToolTip="Gras" Click="Bold_Click"/>
                        <Button Content="I" FontStyle="Italic" Style="{StaticResource ToolFormatButton}" ToolTip="Italique" Click="Italic_Click"/>
                        <Button Content="S" Style="{StaticResource ToolFormatButton}" ToolTip="Souligné" Click="Underline_Click"/>
                        <Rectangle Width="1" Fill="{StaticResource StudiesBorder}" Margin="10,3"/>

                        <Button Style="{StaticResource ToolFormatButton}" ToolTip="Couleur du texte" Click="FontColor_Click">
                            <StackPanel Orientation="Vertical">
                                <Path Fill="White" Stretch="Fill" Height="12" Width="14"
                                      Data="M12 2L8.5 8.5 2.8 9.3l4.2 4-1 5.7 5-2.8 5 2.8-1-5.7 4.2-4-5.7-.8L12 2z"/>
                                <Rectangle x:Name="SelectedColorIndicator" Fill="#FF6B6B" Height="2" Width="14"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource StudiesBorder}" Margin="10,3"/>

                        <Button Content="1." Style="{StaticResource ToolFormatButton}" ToolTip="Liste numérotée" Click="Numbering_Click"/>
                        <Button Style="{StaticResource ToolFormatButton}" ToolTip="Liste à puces" Click="Bullets_Click">
                            <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource StudiesBorder}" Margin="10,3"/>

                        <Button Style="{StaticResource ToolFormatButton}" ToolTip="Aligner à gauche" Click="AlignLeft_Click">
                            <Path Fill="White" Stretch="Fill" Height="12" Width="14"
                                  Data="M3 21h18v-2H3v2zm0-4h12v-2H3v2zm0-4h18v-2H3v2zm0-4h12V7H3v2zm0-4h18V3H3v2z"/>
                        </Button>
                        <Button Style="{StaticResource ToolFormatButton}" ToolTip="Centrer" Click="AlignCenter_Click">
                            <Path Fill="White" Stretch="Fill" Height="12" Width="14"
                                  Data="M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6h10V7H7v2zm-4-4h18V3H3v2z"/>
                        </Button>
                        <Button Style="{StaticResource ToolFormatButton}" ToolTip="Aligner à droite" Click="AlignRight_Click">
                            <Path Fill="White" Stretch="Fill" Height="12" Width="14"
                                  Data="M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zM3 3v2h18V3H3z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
<!-- ===== CONTENU ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource StudiesPanelBg}"
                        BorderBrush="{StaticResource StudiesBorder}" BorderThickness="0,1,1,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="STRUCTURE DES ANALYSES" Foreground="{StaticResource StudiesAccent}"
                                   FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="StudiesSearchBox" TextChanged="StudiesSearchBox_TextChanged"
                                     Padding="6,5" Background="{StaticResource StudiesRadicalBg}"
                                     Foreground="White" BorderBrush="{StaticResource StudiesBorder}"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="🔍  Rechercher une étude..." Foreground="#4A5A6A" FontSize="12"
                                       Margin="7,4" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=StudiesSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TreeView x:Name="StudiesTreeView" Grid.Row="2" Background="Transparent"
                                  BorderThickness="0" Foreground="LightGray"
                                  KeyDown="StudiesTreeView_KeyDown"
                                  SelectedItemChanged="StudiesTreeView_SelectedItemChanged"/>
                    </Grid>
                </Border>

                <!-- Éditeur -->
                <Border Grid.Column="1" Background="{StaticResource StudiesEditorBg}"
                        BorderBrush="{StaticResource StudiesBorder}" BorderThickness="1,1,0,0" Padding="15">
                    <Grid>
                        <RichTextBox x:Name="StudyContentRichTextBox"
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     CaretBrush="White" SelectionBrush="{StaticResource StudiesAccent}"
                                     TextChanged="StudyContentRichTextBox_TextChanged"
                                     DataObject.Pasting="StudyContentRichTextBox_Pasting"
                                     MouseDoubleClick="StudyContentRichTextBox_MouseLeftButtonDown">
                            <FlowDocument>
                                <Paragraph/>
                            </FlowDocument>
                        </RichTextBox>
                        <TextBlock x:Name="EmptyPlaceholder"
                                   Text="Sélectionnez une étude dans la structure à gauche, ou créez-en une nouvelle avec « + Nouvelle étude »."
                                   Foreground="#60707F" FontSize="13" Margin="20,16"
                                   IsHitTestVisible="False" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
<!-- ===== BARRE DE STATUT ===== -->
            <Border Grid.Row="3" Background="{StaticResource StudiesToolbarBg}"
                    BorderBrush="{StaticResource StudiesBorder}" BorderThickness="0,1,0,0" Padding="10,3">
                <DockPanel>
                    <TextBlock x:Name="StudiesStatusText" Text="Prêt" FontSize="11"
                               Foreground="#8099B0" VerticalAlignment="Center"/>
                    <TextBlock Text="Format : .etude (XamlPackage)" FontSize="11"
                               Foreground="#4A5A6A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ===== OVERLAY MIGRATION ===== -->
            <Grid x:Name="MigrationOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#AA000000">
                <Border Background="#151E29" Padding="28" CornerRadius="10"
                        BorderBrush="{StaticResource StudiesAccent}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Migration des anciens fichiers RTF..." Foreground="White"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <ProgressBar x:Name="MigrationProgress" Width="340" Height="22" Margin="10"/>
                        <TextBlock x:Name="MigrationStatus" Text="Migration en cours..."
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>