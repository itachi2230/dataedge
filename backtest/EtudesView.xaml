<UserControl x:Class="backtest.EtudesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:backtest"
             mc:Ignorable="d" Margin="15,0,20,0"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ContextMenu x:Key="StudiesContextMenu">
            <MenuItem Header="✏️ Renommer" Click="Rename_Click" />
            <Separator/>
            <MenuItem Header="🗑️ Supprimer" Click="Delete_Click" />
            <Separator/>
            <MenuItem Header="💾 Sauvegarder" Click="SaveStudy_Click" />
            <MenuItem Header="📄 Exporter PDF ou imprimer" Click="ExportRTF_Click" />
        </ContextMenu>

        <Style TargetType="TreeViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource StudiesContextMenu}"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00AEEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A477A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#154B7C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#00AEEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00AEEF"/>
                                <Setter Property="Foreground" Value="#061A34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactFormatButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1A477A"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Border  BorderBrush="#1A1A2E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" >
                <Button Style="{StaticResource CircleNavButton}" Content="" 
                        FontFamily="Segoe MDL2 Assets" Click="BtnRetour_Click" 
                        ToolTip="Retour au Dashboard"/>

                <TextBlock Text="GESTION DES ÉTUDES" 
                           FontSize="14" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8"/>
            </DockPanel>

            <DockPanel Grid.Row="1"  Margin="0,1,0,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0,0,0">
                    <Button Margin="10,0" ToolTip="Nouveau dossier" Content="📁+" Style="{StaticResource CircleNavButton}" Click="NewFolder_Click" Background="#FF0D5BC8"/>
                    <Button Margin="3,0" ToolTip="Nouveau document" Content="📝+" Style="{StaticResource CircleNavButton}" Click="NewStudy_Click" Background="#FF196EE7"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#015A8F" Margin="10,0"/>
                    <Button Content="💾" ToolTip="Enregistrer" Margin="3,0" Foreground="AliceBlue" Style="{StaticResource CircleNavButton}" Click="SaveStudy_Click"/>
                    <Button Content="📤" ToolTip="Imprimer ou exporter en format pdf" Margin="3,0" Style="{StaticResource CircleNavButton}" Click="ExportRTF_Click"/>
                    <Button Content="🔄" ToolTip="Migrer les anciens formats rtf" Margin="3,0" Style="{StaticResource CircleNavButton}" Click="Button_Click"/>
                </StackPanel>

                <TextBlock x:Name="StudiesTitle" 
                           Text="Fichier: [Nom de l'étude]" 
                           Foreground="#80AEEF" FontSize="11" FontStyle="Italic"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>
                <Grid x:Name="MigrationOverlay" Visibility="Collapsed" Background="#AA000000">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar x:Name="MigrationProgress" Width="300" Height="20" Margin="10"/>
                        <TextBlock x:Name="MigrationStatus" Text="Migration en cours..." Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,7">
                    <ComboBox x:Name="FontSizeComboBox" Width="50"  
                              SelectedIndex="2" SelectionChanged="FontSize_SelectionChanged"  
                              VerticalAlignment="Center" Margin="0,0,10,0">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="36"/>
                    </ComboBox>

                    <Button Content="G" FontWeight="Bold" Style="{StaticResource CompactFormatButtonStyle}" Click="Bold_Click"/>
                    <Button Content="I" FontStyle="Italic" Style="{StaticResource CompactFormatButtonStyle}" Click="Italic_Click"/>
                    <Button Content="S" Style="{StaticResource CompactFormatButtonStyle}" Click="Underline_Click"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#015A8F" Margin="10,0"/>

                    <Button Style="{StaticResource CompactFormatButtonStyle}" Click="FontColor_Click" ToolTip="Couleur">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Path Fill="White" Data="M12 2L4.2 21h2.1l1.8-5h7.8l1.8 5h2.1L12 2zm-2 12L12 7.3 14 14H10z" Height="12" Stretch="Fill"/>
                            <Rectangle x:Name="SelectedColorIndicator" Fill="#FF6B6B" Height="2" Width="14"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#015A8F" Margin="10,0"/>

                    <Button Content="1." Style="{StaticResource CompactFormatButtonStyle}" Click="Numbering_Click"/>
                    <Button Style="{StaticResource CompactFormatButtonStyle}" Click="Bullets_Click">
                        <Path Fill="White" Data="M3 4h2v2H3V4zm4 1h14v2H7V5zm0 10h14v2H7v-2zm-4 0h2v2H3v-2zm0-5h2v2H3v-2zm4 1h14v2H7v-2z" Width="12" Height="12" Stretch="Fill"/>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#015A8F" Margin="10,0"/>

                    <Button Style="{StaticResource CompactFormatButtonStyle}" Click="AlignLeft_Click">
                        <Path Fill="White" Data="M3 21h18v-2H3v2zm0-4h12v-2H3v2zm0-4h18v-2H3v2zm0-4h12V7H3v2zm0-4h18V3H3v2z" Width="12" Height="12" Stretch="Fill"/>
                    </Button>
                    <Button Style="{StaticResource CompactFormatButtonStyle}" Click="AlignCenter_Click">
                        <Path Fill="White" Data="M7 15v2h10v-2H7zm-4 6h18v-2H3v2zm0-8h18v-2H3v2zm4-6h10V7H7v2zm-4-4h18V3H3v2z" Width="12" Height="12" Stretch="Fill"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"  Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="STRUCTURE DES ANALYSES" Foreground="#00AEEF" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
                        <TreeView x:Name="StudiesTreeView" Grid.Row="1" Background="Transparent" 
                                  BorderThickness="0" Foreground="LightGray" KeyDown="StudiesTreeView_KeyDown"
                                  SelectedItemChanged="StudiesTreeView_SelectedItemChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#0A0A12" Margin="1,0,0,0" Padding="15">
                    
                    <RichTextBox x:Name="StudyContentRichTextBox" 
                                 Background="Transparent" BorderThickness="0" Foreground="White" 
                                 CaretBrush="White" SelectionBrush="#00AEEF"
                                 TextChanged="StudyContentRichTextBox_TextChanged"
                                 DataObject.Pasting="StudyContentRichTextBox_Pasting"
                                 MouseDoubleClick="StudyContentRichTextBox_MouseLeftButtonDown">
                        <FlowDocument>
                            <Paragraph Foreground="Gray">
                                <Run Text="Sélectionnez un fichier d'étude..."/>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>