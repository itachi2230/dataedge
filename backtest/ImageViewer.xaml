<Window x:Class="backtest.ImageViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu Image" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" 
        WindowState="Maximized">

    <Grid Background="#EE000010">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ImageContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">

                <Image x:Name="ImageHaut" 
                       Stretch="Uniform" 
                       Margin="0,0,0,10"
                       MaxWidth="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, ConverterParameter=0.9}"
                       Visibility="Collapsed"/>

                <Image x:Name="ImageBas" 
                       Stretch="Uniform" 
                       MaxWidth="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, ConverterParameter=0.9}"
                       Visibility="Collapsed"/>

                <TextBlock Text="Cliquez n'importe où pour fermer" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,0" 
                           FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>