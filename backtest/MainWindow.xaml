<Window x:Class="backtest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:local="clr-namespace:backtest"
        Title="Performance Dashboard" Height="850" Width="1350"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        
        AllowsTransparency="True" WindowStyle="None" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="20" BorderBrush="#222" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24.8"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="145"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Border x:Name="SidePanel"
        Grid.Row="1" Grid.RowSpan="2" 
        Grid.Column="0" Grid.ColumnSpan="2"
        HorizontalAlignment="Right"
        Width="25" 
        Background="{StaticResource CardBg}"
        Margin="0,20,0,20"
        CornerRadius="80,0,0,80"
        BorderBrush="#444"
        BorderThickness="1,1,0,1"
        Panel.ZIndex="9999">
                <Border.Effect>
                    <DropShadowEffect Color="LightBlue" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="25" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SidePanel}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Margin="0,5">
                        <Button Style="{StaticResource CircleNavButton}" Content="📊" Click="Button_Click_3" Margin="0"/>
                        <TextBlock Text="ÉLUDES" Foreground="Gray" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <Button Style="{StaticResource CircleNavButton}" Content="⚙️" Margin="0"/>
                        <TextBlock Text="CONFIG" Foreground="Gray" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <Button Style="{StaticResource CircleNavButton}" Content="🔔" Margin="0"/>
                        <TextBlock Text="NOTIFS" Foreground="Gray" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#333" Margin="10,10" Width="25"/>

                    <StackPanel Margin="0,5">
                        <Button Style="{StaticResource CircleNavButton}" Content="🛠" Margin="0"/>
                        <TextBlock Text="OUTILS" Foreground="Gray" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Border>
            <Grid Grid.Row="0" Margin="20,0,0,0" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TERMINAL" Foreground="{StaticResource AccentBlue}" FontWeight="Black" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="PRO" Foreground="White" FontWeight="Thin" FontSize="18" Margin="5,0" Opacity="0.5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1A2432" CornerRadius="15" Padding="12,6" Margin="0,0,15,0" BorderBrush="#333" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="userNameText" Text="TRADER_CONNECTED" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="—" Click="MinimizeButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" Width="30" FontSize="16"/>
                    <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Width="30" FontSize="16"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="MainViewContainer" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0">
                <Grid x:Name="DashboardView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="263*"/>
                            <ColumnDefinition Width="263*"/>
                            <ColumnDefinition Width="430*"/>
                            <ColumnDefinition Width="114*"/>
                            <ColumnDefinition Width="233*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="8,15,5.2,0">
                            <UniformGrid Columns="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="BUY" Foreground="Gray" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Ellipse Stroke="#1A2432" StrokeThickness="3" Width="70" Height="70"/>
                                        <Ellipse x:Name="RingBuy" Stroke="{StaticResource AccentBlue}" StrokeThickness="5" Width="70" Height="70" StrokeDashArray="3,1"/>
                                        <TextBlock x:Name="tauxBuy" Text="0%" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SELL" Foreground="Gray" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Ellipse Stroke="#1A2432" StrokeThickness="3" Width="70" Height="70"/>
                                        <Ellipse x:Name="RingSell" Stroke="{StaticResource NeonPink}" StrokeThickness="5" Width="70" Height="70" StrokeDashArray="3,1"/>
                                        <TextBlock x:Name="tauxSell" Text="0%" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="10.8,15,4.4,0">
                            <UniformGrid Columns="2" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="BEST" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="meilleurePaire" Text="---" Foreground="LightGreen" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="WORST" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PirePaire" Text="---" Foreground="#FF6A02" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Column="2" Margin="14.6,0,3.8,-0.2">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="5,0,5,0">
                                    <TextBlock Text="STRATÉGIES" 
                       Foreground="Gray" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>

                                    <Button HorizontalAlignment="Right" 
                    Width="30" Height="30"
                    Content="+" 
                    FontSize="18"
                    FontWeight="Bold"
                    Style="{StaticResource CircleNavButton}" 
                    Click="AddStrategy_Click"
                    ToolTip="Ajouter une nouvelle stratégie" Background="#FF478DF0"/>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="perfStrat" 
                        Orientation="Vertical" 
                        VerticalAlignment="Top" 
                        Margin="0,0,0,0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>

                        <Grid Grid.Column="4" Margin="0.8,0,0,-0.2">
                            <Ellipse Stroke="{StaticResource AccentBlue}" StrokeThickness="2" Width="120" Height="120" Opacity="0.9">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="15"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="{StaticResource AccentBlue}" StrokeThickness="3" Width="120" Height="120" StrokeDashArray="10,5" Opacity="0.9"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="nbreText" Text="0" Foreground="White" FontSize="35" FontWeight="Black" HorizontalAlignment="Center"/>
                                <TextBlock Text="TRADES" Foreground="{StaticResource AccentBlue}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,10,0,4.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="JOURNAL DE TRADING" 
                   Foreground="SlateGray" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center"/>

                                    <Button x:Name="AddTradeButton" 
                Content="+" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Width="28" Height="28"
                FontSize="18"
                FontWeight="Bold"
                Style="{StaticResource CircleNavButton}" 
                Click="AddTradeButton_Click"
                ToolTip="Ajouter un nouveau trade" Background="#FF7C456F"/>
                                </Grid>

                                <DataGrid x:Name="TradesDataGri" 
              Background="Transparent" 
              BorderThickness="0" 
              AutoGenerateColumns="False" 
              HeadersVisibility="Column" 
              IsReadOnly="True" 
              GridLinesVisibility="None" 
              RowStyle="{StaticResource FuturisticRowStyle}" 
              ColumnHeaderStyle="{StaticResource FuturisticColumnHeader}" 
              MouseDoubleClick="TradesDataGri_MouseDoubleClick" 
              VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PAIRE" Binding="{Binding Paire}" Width="*" FontWeight="Bold"/>
                                        <DataGridTemplateColumn Header="TYPE" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2" Background="{Binding TypeOrdre, Converter={StaticResource TypeToColorConverter}}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding TypeOrdre}" FontSize="10" FontWeight="Black" Foreground="Black"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="PROFIT" Binding="{Binding Profit}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Foreground" Value="{Binding Profit, Converter={StaticResource ProfitToColorConverter}}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="NOTES HEBDOMADAIRES" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Opacity="0.8"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                    <Button Content="❮" Click="PreviousWeek_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock x:Name="weekStartDateText" Foreground="White" VerticalAlignment="Center" Margin="15,0" FontSize="12"/>
                                    <Button Content="❯" Click="NextWeek_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <RichTextBox x:Name="richTextBoxNotesWeeks" Grid.Row="2" Background="#0D141D" Foreground="#EEE" BorderThickness="0" Padding="10" FontSize="14"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ContentControl>

            <Grid Grid.Row="3" Margin="25,0.4,0,0">
                

                <Button Content="CALENDRIER ECO" Click="Button_Click" Background="#1A2432" Foreground="White" Width="120" Height="36" HorizontalAlignment="Right" Margin="0,0,70,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="#333" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Popup x:Name="StrategyPopup" PlacementTarget="{Binding ElementName=AddTradeButton}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="8">
                    <ListBox x:Name="StrategyListBox" SelectionChanged="StrategyListBox_SelectionChanged" Width="200" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </Border>
            </Popup>
            <Border x:Name="annoncesInvesting" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="100,100,100,0" Visibility="Collapsed" Panel.ZIndex="200">
                <cef:ChromiumWebBrowser x:Name="InvestingCalendarBrowser"/>
            </Border>
        </Grid>
    </Border>
</Window>