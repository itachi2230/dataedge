<UserControl x:Class="backtest.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="CircularProfileImage" TargetType="Ellipse">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Stroke" Value="Cyan"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Cyan" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#1A1A1A" BorderThickness="0" >
        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,40,0" >
                <Button Style="{StaticResource CircleNavButton}" 
            Content="" 
            FontFamily="Segoe MDL2 Assets" 
            Click="BtnRetour_Click" 
            ToolTip="Retour au Dashboard"
            HorizontalAlignment="Left"
            Margin="0,0,0,30"
            Width="40" Height="40"
            FontSize="16"/>

                <TextBlock Text="PARAMÈTRES" Foreground="Cyan" FontSize="18" FontWeight="ExtraBold" Margin="0,0,0,50">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Cyan" BlurRadius="15" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Button x:Name="BtnAppTab" Content="APPLICATION" Style="{StaticResource CyberButton}" Click="BtnAppTab_Click"
            Height="30" Margin="0,8" HorizontalAlignment="Stretch" FontSize="14"/>

                <Button x:Name="BtnAccountTab" Content="COMPTE GLOBAL" Style="{StaticResource CyberButton}" Click="BtnAccountTab_Click"
            Height="30" Margin="0,8" Foreground="Gray" BorderBrush="#222" HorizontalAlignment="Stretch" FontSize="14"/>

                <Button x:Name="BtnCloudTab" Content="CLOUD" Style="{StaticResource CyberButton}" Click="BtnCloudTab_Click"
            Height="30" Margin="0,8" Foreground="Gray" BorderBrush="#222" HorizontalAlignment="Stretch" FontSize="14"/>
            </StackPanel>

            <Border Grid.Column="1" CornerRadius="20" Padding="40,20" Background="{StaticResource CardBg}" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="Both">
                        <Grid x:Name="AccountGrid" MaxWidth="800" HorizontalAlignment="Stretch" VerticalAlignment="Top">

                            <StackPanel x:Name="PanelApp" Visibility="Visible">
                                <TextBlock Text="CONFIGURATION SYSTÈME" Foreground="White" FontSize="24" Margin="0,0,0,10" FontWeight="Bold"/>
                                <TextBlock Text="Personnalisez votre expérience locale DataEdge." Foreground="Gray" FontSize="12" Margin="0,0,0,40"/>
                                <CheckBox Content="Lancer au démarrage de Windows" Foreground="White" Margin="0,10"/>
                                <CheckBox Content="Activer les alertes sonores" IsChecked="True" Foreground="White" Margin="0,10"/>
                                <Separator Margin="0,15,0,5" Background="#333"/>
                                <TextBlock Text="COPILOTE IA" Foreground="Cyan" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                                <CheckBox x:Name="ChkAgentEnabled" Content=" Activer le copilote IA (agent)" IsChecked="True"
                                          Foreground="White" Margin="0,5" VerticalAlignment="Center"
                                          Click="ChkAgentEnabled_Click"/>
                                <TextBlock Text="Lorsqu'il est désactivé, le bouton de l'agent est masqué et le copilote n'est plus accessible depuis l'interface."
                                          Foreground="Gray" FontSize="10" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Justify"/>
                                <TextBlock Text="Langue de l'interface" Foreground="Gray" Margin="0,20,0,10" FontSize="11" FontWeight="Bold"/>
                                <ComboBox Background="#111" Foreground="White" BorderBrush="#333" Height="40" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="Français (FR)"/>
                                    <ComboBoxItem Content="English (US)"/>
                                </ComboBox>

                                <Separator Margin="0,15,0,5" Background="#333"/>
                                <TextBlock Text="SYNCHRONISATION CLOUD" Foreground="Cyan" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                                <CheckBox x:Name="ChkSyncCacheImageLegacy" Content="Synchroniser le dossier cacheimage/ (captures d'écran re-générables)"
                                          Foreground="White" Margin="0,5"
                                          Click="ChkSyncCacheImage_Click"/>
                                <TextBlock Text="Désactiver ce dossier accélère fortement la synchro : les captures sont des caches qui peuvent être recréés sur chaque appareil."
                                          Foreground="Gray" FontSize="10" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Justify"/>
                                <Button x:Name="BtnSyncNow" Content="SYNCHRONISER MAINTENANT" Click="BtnSyncNow_Click"
                                        Style="{StaticResource CyberButton}" Height="40" Margin="0,5"/>
                                <TextBlock x:Name="TxtSyncStatus" Text="Aucune synchronisation récente." Foreground="Gray" FontSize="10" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCloud" Visibility="Collapsed">
                                <!-- ====== EN-TÊTE ====== -->
                                <TextBlock Text="MON CLOUD" Foreground="White" FontSize="24" Margin="0,0,0,5" FontWeight="Bold"/>
                                <TextBlock Text="Vos stratégies, études, notes hebdomadaires et captures : tout est sauvegardé automatiquement." Foreground="Gray" FontSize="12" Margin="0,0,0,12"/>

                                <!-- ====== BARRE DE PROGRESSION SYNCHRO ====== -->
                                <Border x:Name="BorderSyncProgress" Visibility="Collapsed" Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtSyncPhase" Text="" Foreground="Cyan" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSyncPercent" Text="" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ProgressBar x:Name="ProgSync" Height="6" Background="#111" Foreground="Cyan" BorderThickness="0" Maximum="100" Value="0"/>
                                        <TextBlock x:Name="TxtSyncCurrentFile" Text="" Foreground="#666" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <!-- ====== STATS CARTES (grille 2x2) ====== -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Foreground="#555" FontSize="9" FontWeight="Bold" Text="STOCKAGE"/>
                                            <TextBlock x:Name="TxtCloudStorage" Text="---" Foreground="Cyan" FontSize="20" FontWeight="Bold" Margin="0,4,0,0">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Cyan" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,6">
                                        <StackPanel>
                                            <TextBlock Foreground="#555" FontSize="9" FontWeight="Bold" Text="ÉLÉMENTS"/>
                                            <TextBlock x:Name="TxtCloudFileCount" Text="0" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,6,6,0">
                                        <StackPanel>
                                            <TextBlock Foreground="#555" FontSize="9" FontWeight="Bold" Text="VERSIONS"/>
                                            <TextBlock x:Name="TxtCloudBackupCount" Text="0" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,6,0,0">
                                        <StackPanel>
                                            <TextBlock Foreground="#555" FontSize="9" FontWeight="Bold" Text="DERNIÈRE SYNCHRO"/>
                                            <TextBlock x:Name="TxtCloudLastSync" Text="---" Foreground="#AAA" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- ====== ONGLETS VOS DONNÉES / VERSIONS ====== -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="TabFiles" Grid.Column="0" Content="📁  VOS DONNÉES" IsChecked="True" Height="38"
                                                  FontSize="11" FontWeight="Bold" Cursor="Hand" Click="TabFiles_Click">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Foreground" Value="#666"/>
                                                <Setter Property="Background" Value="#0A0A0A"/>
                                                <Setter Property="BorderBrush" Value="#1E1E1E"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="Cyan"/>
                                                        <Setter Property="Background" Value="#11181F"/>
                                                        <Setter Property="BorderBrush" Value="Cyan"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#11181F"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ToggleButton x:Name="TabBackups" Grid.Column="1" Content="🕘  VERSIONS" IsChecked="False" Height="38"
                                                  FontSize="11" FontWeight="Bold" Cursor="Hand" Click="TabBackups_Click">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Foreground" Value="#666"/>
                                                <Setter Property="Background" Value="#0A0A0A"/>
                                                <Setter Property="BorderBrush" Value="#1E1E1E"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Foreground" Value="Cyan"/>
                                                        <Setter Property="Background" Value="#11181F"/>
                                                        <Setter Property="BorderBrush" Value="Cyan"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#11181F"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>
                                <!-- ====== VUE VOS DONNÉES ====== -->
                                <Border x:Name="ViewFiles" Background="#080808" BorderBrush="Cyan" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtCloudSearch" Style="{StaticResource CyberTextBox}" Height="36" FontSize="12"
                                                     VerticalContentAlignment="Center" TextChanged="TxtCloudSearch_TextChanged"/>
                                            <TextBlock x:Name="TxtCloudSearchPlaceholder" Text="🔍  Rechercher une stratégie, une étude, une semaine…" Foreground="#555555" FontSize="12" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            <Button x:Name="BtnCloudRefresh" Grid.Column="1" Content="RAFRAÎCHIR" Style="{StaticResource CyberButton}"
                                                    Height="36" Margin="10,0,0,0" Click="BtnCloudRefresh_Click" Width="110" FontSize="11"/>
                                        </Grid>
                                        <StackPanel Margin="0,0,8,4">
                                            <CheckBox x:Name="ChkShowTechnical" Content="Afficher les fichiers techniques (gérés automatiquement par le logiciel)"
                                                      Foreground="#888" FontSize="10" Click="ChkShowTechnical_Click" Cursor="Hand"/>
                                        </StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="TYPE" Foreground="#444" FontSize="9" FontWeight="Bold" Grid.Column="0" Margin="0,0,8,0"/>
                                            <TextBlock Text="ÉLÉMENT" Foreground="#444" FontSize="9" FontWeight="Bold" Grid.Column="1"/>
                                            <TextBlock Text="TAILLE" Foreground="#444" FontSize="9" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Right"/>
                                            <TextBlock Text="DATE" Foreground="#444" FontSize="9" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ListBox x:Name="LvCloudFiles" Height="170" Background="Transparent" BorderThickness="0"
                                                 SelectionMode="Single" SelectionChanged="LvCloudFiles_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,1"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,6">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#151515"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#11181F"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="Cyan"/>
                                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding CategoryBrush}" CornerRadius="3" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{Binding CategoryTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#CCC" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SubLabel}" Foreground="#666" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#555" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" Foreground="#444" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Boutons d'action des données -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="BtnCloudRestoreFile" Content="⬇  RESTAURER EN LOCAL" Style="{StaticResource CyberButton}"
                                                    Height="36" Margin="0,0,10,0" Click="BtnCloudRestoreFile_Click" FontSize="11"/>
                                            <Button x:Name="BtnCloudDeleteFile" Content="🗑  SUPPRIMER DU CLOUD" Style="{StaticResource CyberButton}"
                                                    Height="36" Foreground="#FF4545" BorderBrush="#331111" Click="BtnCloudDeleteFile_Click" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
    

                                <!-- ====== VUE VERSIONS ====== -->
                                <Border x:Name="ViewBackups" Visibility="Collapsed" Background="#080808" BorderBrush="Cyan" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="VERSIONS PRÉCÉDENTES" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="Sélectionnez un élément dans l'onglet « Vos données » pour voir ses versions précédentes, ou visualisez toutes les versions ci-dessous."
                                                   Foreground="Gray" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtBackupFilterInfo" Text="Toutes les versions du compte :" Foreground="#666" FontSize="10" Margin="0,0,0,8" FontWeight="Bold"/>
                                        <ListBox x:Name="LstCloudBackups" Height="160" Background="#050505" BorderBrush="#1E1E1E" BorderThickness="1"
                                                 Foreground="White" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#111"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#151515"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#11181F"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Button x:Name="BtnCloudRestoreBackup" Content="⬆  RESTAURER CETTE SAUVEGARDE SUR LE SERVEUR" Style="{StaticResource CyberButton}"
                                                Height="40" Margin="0,12,0,0" Click="BtnCloudRestoreBackup_Click" FontSize="11"/>
                                        <TextBlock Text="Une restauration écrase la version actuelle du fichier sur le serveur (la sauvegarde est conservée)."
                                                   Foreground="Gray" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- ====== PARAMÈTRES DE SYNCHRONISATION (repliés) ====== -->
                                <Expander Margin="0,12,0,0" Background="#0A0A0A" BorderBrush="#1E1E1E" BorderThickness="1" Foreground="White"
                                          Header="Paramètres de synchronisation" FontSize="11" Cursor="Hand">
                                    <StackPanel Margin="10,10,10,10">
                                        <TextBlock Text="Décochez une catégorie pour l'exclure de la synchronisation (vos données existantes restent conservées côté serveur)."
                                                   Foreground="Gray" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkSyncData" Content="Stratégies &amp; journal" Foreground="White" Margin="0,0,24,8" Click="ChkSyncFolder_Click" FontSize="11"/>
                                            <CheckBox x:Name="ChkSyncEtudes" Content="Études" Foreground="White" Margin="0,0,24,8" Click="ChkSyncFolder_Click" FontSize="11"/>
                                            <CheckBox x:Name="ChkSyncNotes" Content="Notes hebdomadaires" Foreground="White" Margin="0,0,24,8" Click="ChkSyncFolder_Click" FontSize="11"/>
                                            <CheckBox x:Name="ChkSyncCacheImage" Content="Captures d'écran (trades)" Foreground="White" Margin="0,0,24,8" Click="ChkSyncFolder_Click" FontSize="11"/>
                                            <CheckBox x:Name="ChkSyncMetadata" Content="Fichiers techniques" Foreground="White" Margin="0,0,0,8" Click="ChkSyncFolder_Click" FontSize="11"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>


                            <StackPanel x:Name="PanelLogin" Visibility="Collapsed">
                                <TextBlock Text="CONNEXION FX-GLOBAL" Foreground="White" FontSize="24" Margin="0,0,0,10" FontWeight="Bold"/>
                                <TextBlock Text="Accédez à votre écosystème de suivi synchronisé." Foreground="Gray" FontSize="12" Margin="0,0,0,40"/>

                                <TextBlock Text="EMAIL OU TÉLÉPHONE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox x:Name="TxtIdentifier" Style="{StaticResource CyberTextBox}" Height="45" Margin="0,0,0,25" FontSize="16" VerticalContentAlignment="Center"/>

                                <TextBlock Text="MOT DE PASSE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="TxtPassword" Style="{StaticResource CyberPasswordBox}" Height="45" Margin="0,0,0,30" FontSize="16" VerticalContentAlignment="Center"/>

                                <Button Name="btnLogin" Content="SE CONNECTER" Click="Login_Click" Style="{StaticResource CyberButton}" Height="55" Margin="0,10,0,20" FontSize="14" FontWeight="Bold" Background="#1100f2ff"/>

                                <Button Content="Pas encore de compte ? Créer un profil FX-Global" Background="Transparent" BorderThickness="0" 
                                        Foreground="Cyan" Click="ShowRegister_Click" HorizontalAlignment="Center" Opacity="0.8"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelProfile" Visibility="Collapsed">
                                <Grid Margin="0,0,0,40">
                                    <TextBlock Text="PROFIL FX-GLOBAL" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnEditToggle" Content="MODIFIER" HorizontalAlignment="Right" Style="{StaticResource CyberButton}" 
                Width="100" Height="30" FontSize="10" Click="BtnEditToggle_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Cursor="Hand" MouseDown="SelectPhotoUpdate_Click">
                                        <Ellipse Width="120" Height="120" Stroke="Cyan" StrokeThickness="2">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="ImgUserSession" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="Cyan" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <Border x:Name="EditPhotoOverlay" Background="#AA000000" CornerRadius="60" Visibility="Collapsed">
                                            <TextBlock Text="CHANGER" Foreground="Cyan" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                        <TextBlock x:Name="TxtSessionName" Text="NOM UTILISATEUR" Foreground="White" FontSize="26" FontWeight="ExtraBold"/>
                                        <TextBox x:Name="EditFullName" Style="{StaticResource CyberTextBox}" Visibility="Collapsed" Height="40" FontSize="18"/>

                                        <Border Background="#1100ff00" HorizontalAlignment="Left" Padding="10,4" CornerRadius="4" Margin="0,8,0,0">
                                            <TextBlock Text="MODE HORS-LIGNE DISPONIBLE" Foreground="LimeGreen" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" Margin="30">
        <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="ADRESSE EMAIL" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TxtProfileEmail" Text="---" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="NUMÉRO DE TÉLÉPHONE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="TxtProfilePhone" Text="---" Foreground="White" FontSize="14" />
                                <TextBox x:Name="EditPhone" Style="{StaticResource CyberTextBox}" Visibility="Collapsed" Height="35"/>
                            </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="MA SIGNATURE / BIO" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Border Background="#050505" BorderBrush="#1A1A1A" BorderThickness="1" Padding="15" CornerRadius="8">
                                <Grid>
                                    <TextBlock x:Name="TxtProfileBio" Text="Aucune description disponible." Foreground="Gray" TextWrapping="Wrap" FontStyle="Italic"/>
                                    <TextBox x:Name="EditBio" Style="{StaticResource CyberTextBox}" Visibility="Collapsed" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="ActionButtons" Margin="0,40,0,0">
                                    <Button x:Name="BtnSaveProfile" Content="SAUVEGARDER LES MODIFICATIONS" Visibility="Collapsed" 
                Style="{StaticResource CyberButton}" Height="50" Foreground="Cyan" Click="BtnSaveProfile_Click"/>
                                </StackPanel>

                            <Separator Background="#1A1A1A" Margin="0,8"/>
                            <Button x:Name="BtnLogout" Content="DÉCONNEXION" Click="Logout_Click" Style="{StaticResource CyberButton}" 
            Height="45" Foreground="#FF4545" BorderBrush="#331111" />
                            </StackPanel>
                            <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                                <TextBlock Text="INSCRIPTION FX-GLOBAL" Foreground="White" FontSize="24" FontWeight="Bold"/>

                                <StackPanel Orientation="Horizontal" Margin="0,30,0,40">
                                    <Grid Cursor="Hand" MouseDown="SelectPhoto_Click">
                                        <Ellipse Style="{StaticResource CircularProfileImage}">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="ImgProfilePreview" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Border Background="Cyan" Width="35" Height="35" CornerRadius="20" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                            <TextBlock Text="+" Foreground="Black" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
                                        <TextBlock Text="IDENTITÉ VISUELLE" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Format recommandé : JPG ou PNG" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="NOM COMPLET" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox x:Name="RegFullName" Style="{StaticResource CyberTextBox}" Height="45" Margin="0,0,0,25"/>

                                <Grid Margin="0,0,0,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,15,0">
                                        <TextBlock Text="EMAIL" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBox x:Name="RegEmail" Style="{StaticResource CyberTextBox}" Height="45"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="TÉLÉPHONE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBox x:Name="RegPhone" Style="{StaticResource CyberTextBox}" Height="45"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="BIO / SIGNATURE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox x:Name="RegBio" Style="{StaticResource CyberTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,25" Padding="10"/>

                                <TextBlock Text="MOT DE PASSE" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="RegPassword" Style="{StaticResource CyberPasswordBox}" Height="45" Margin="0,0,0,40"/>

                                <Button Name="btnRegister" Content="INITIALISER LE COMPTE" Style="{StaticResource CyberButton}" Height="55" FontWeight="Bold" Click="Register_Click"/>
                                <Button Content="Retour à l'identification" Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,20" Click="ShowLogin_Click"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="CyberToast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                            Background="#050505" BorderBrush="Cyan" BorderThickness="1" CornerRadius="4" Padding="20,10" Margin="0,0,0,30">
                        <Border.Effect>
                            <DropShadowEffect x:Name="ToastGlow" Color="Cyan" BlurRadius="15" Opacity="0.5" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse x:Name="ToastIconCircle" Stroke="Cyan" StrokeThickness="2"/>
                                <Path x:Name="ToastIconPath" Data="M 4,9 L 8,13 L 14,5" Stroke="Cyan" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <TextBlock x:Name="ToastText" Text="NOTIFICATION" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>