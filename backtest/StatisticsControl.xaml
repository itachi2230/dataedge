<UserControl x:Class="backtest.StatisticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:backtest"
             Background="{StaticResource BgDark}">
    <Grid Margin="15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1297*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Style="{StaticResource CircleNavButton}" Content="" 
            FontFamily="Segoe MDL2 Assets" Click="BackToDashboard_Click" 
            ToolTip="Retour au Dashboard"/>

            
            <Button Style="{StaticResource CircleNavButton}" Content="" 
            FontFamily="Segoe MDL2 Assets" Margin="10,0,10,0" ToolTip="Partager PDF" Click="SharePdf_Click"/>

            <!-- Bouton Backtest avec icône de Chart (Analytics) -->
            <Button x:Name="BtnBacktest"
            Style="{StaticResource CircleNavButton}" 
            Content="" 
            FontFamily="Segoe MDL2 Assets" 
            Click="OpenBacktest_Click" 
            ToolTip="Mode Replay / Backtest"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="0,0,0,-0.2" Grid.Row="2">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="600"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="5">
                        <StackPanel>
                            <TextBox Name="nomText" Text="STRATÉGIE" Foreground="{StaticResource AccentBlue}" 
                                 FontSize="22" FontWeight="Bold" Background="Transparent" BorderThickness="0" IsReadOnly="True"/>
                            <Separator Background="{StaticResource AccentBlue}" Opacity="0.2" Margin="0,10"/>
                            <RichTextBox x:Name="richTextBox" Height="150" Background="Transparent" BorderThickness="0" 
                                     Foreground="#CCC" FontSize="13" VerticalScrollBarVisibility="Auto">
                                <FlowDocument>
                                    <Paragraph/>
                                </FlowDocument>
                            </RichTextBox>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">


                        <UniformGrid x:Name="MyStackPanel2" Columns="2" Rows="2" Width="280">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid x:Name="MyStackPanel1" Columns="1" Width="140">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="18"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Foreground="Gray" FontSize="12"/>
                                    <TextBlock FontSize="18"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource CardStyle}" Width="190" Padding="20,35">
                            <Grid>
                                <Ellipse Stroke="#1A2432" StrokeThickness="8"/>
                                <Ellipse Stroke="{StaticResource AccentBlue}" StrokeThickness="7" StrokeDashArray="4,2"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="nbreTrade" Text="0" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="TRADES" Foreground="Gray" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColDataGrid" Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="ColVisual" Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="DataGridContainer" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBlue}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="HISTORIQUE DES TRADES" Foreground="Gray" FontWeight="Bold" Margin="5,0,0,10" FontSize="10" />
                            <DataGrid x:Name="TradesDataGrid" RowStyle="{StaticResource FuturisticRowStyle}" 
                                  ColumnHeaderStyle="{StaticResource FuturisticColumnHeader}"
                                  ToolTip="Touche clavier 'delete' pour supprimer et 'espace' pour modifier un trade"
                                  Background="Transparent" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True"
                                  MouseRightButtonDown="addTrade"  PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                                  SelectionChanged="TradesDataGrid_SelectionChanged" KeyUp="TradesDataGrid_KeyUp"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5">
                        <Button Content="⏴" Foreground="{StaticResource AccentBlue}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleDataGrid_Click"/>
                        <Button Content="⏵" Foreground="{StaticResource AccentBlue}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleVisual_Click" Margin="0,20,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" x:Name="VisualContainer" Style="{StaticResource CardStyle}" 
                    BorderBrush="{StaticResource NeonPink}" BorderThickness="0,1,0,0">
                        <local:TradeVisualizerControl x:Name="TradeVisualizer" />
                    </Border>
                </Grid>

                <Border PreviewMouseWheel="DataGrid_PreviewMouseWheel" Grid.Row="3" x:Name="ComplexStatsContainer"  Style="{StaticResource CardStyle}" MinHeight="400">
                    <StackPanel x:Name="ComplexStatsHost" >
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>