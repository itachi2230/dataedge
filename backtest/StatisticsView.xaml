<UserControl x:Class="backtest.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <UserControl.Resources>
        <Style x:Key="AnalyticCard" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderBrush" Value="#1f2937"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ExplainText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#030712">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource AnalyticCard}" BorderBrush="Cyan">
                        <StackPanel>
                            <TextBlock Text="EXPECTANCY" Foreground="Cyan" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtExpectancy" Text="0.00 R" Foreground="White" FontSize="24" FontWeight="Black"/>
                            <TextBlock Text="Gain moyen par trade" Style="{StaticResource ExplainText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AnalyticCard}" BorderBrush="Orange">
                        <StackPanel>
                            <TextBlock Text="PROFIT FACTOR" Foreground="Orange" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtProfitFactor" Text="1.00" Foreground="White" FontSize="24" FontWeight="Black"/>
                            <TextBlock Text="Gains vs Pertes" Style="{StaticResource ExplainText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AnalyticCard}" BorderBrush="SpringGreen">
                        <StackPanel>
                            <TextBlock Text="WINRATE" Foreground="SpringGreen" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtWinrate" Text="0%" Foreground="White" FontSize="24" FontWeight="Black"/>
                            <TextBlock Text="Probabilité de succès" Style="{StaticResource ExplainText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AnalyticCard}" BorderBrush="MediumPurple">
                        <StackPanel>
                            <TextBlock Text="MAX DRAWDOWN" Foreground="MediumPurple" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtMaxDrawdown" Text="0.0 R" Foreground="White" FontSize="24" FontWeight="Black"/>
                            <TextBlock Text="Chute max historique" Style="{StaticResource ExplainText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource AnalyticCard}" Height="350">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="COURBE D'ÉQUITÉ (CUMULÉ)" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Visualisation de la croissance du compte en unités de risque (R)." Style="{StaticResource ExplainText}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <oxy:PlotView x:Name="PlotEquity" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                    </DockPanel>
                </Border>
              
                <Border Style="{StaticResource AnalyticCard}" BorderBrush="#3b82f6" BorderThickness="0,0,0,5">
                    <StackPanel>
                        <TextBlock Text="💡 AUDIT EXÉCUTIF" Style="{StaticResource TitleText}"/>
                        <TextBlock x:Name="TxtExecutiveSummary" Text="..." Foreground="White" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                        <Border Background="#1e3a8a" Padding="15" CornerRadius="8" Margin="0,15,0,0">
                            <TextBlock x:Name="TxtKeyAdvice" Text="Conseil en attente..." Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AnalyticCard}">
                        <StackPanel>
                            <TextBlock Text="EXPECTANCY PAR JOUR" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Identifiez les jours où vous devriez trader plus gros ou vous reposer." Style="{StaticResource ExplainText}" Margin="0,0,0,15"/>
                            <oxy:PlotView x:Name="PlotWeekly" Height="250" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AnalyticCard}">
                        <StackPanel>
                            <TextBlock Text="SESSIONS" Style="{StaticResource TitleText}"/>
                            <UniformGrid Columns="1" Height="250">
                                <oxy:PlotView x:Name="PlotTokyo" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                                <oxy:PlotView x:Name="PlotLondon" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                                <oxy:PlotView x:Name="PlotNewYork" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AnalyticCard}">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE PAR PAIRE" Style="{StaticResource TitleText}"/>
                            <ItemsControl x:Name="PairStatsContainer">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Margin="5" Background="#1f2937" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <oxy:PlotView Height="120" Model="{Binding Value}" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AnalyticCard}">
                        <StackPanel>
                            <TextBlock Text="BUY VS SELL" Style="{StaticResource TitleText}"/>
                            <ItemsControl x:Name="OrderTypeContainer">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10">
                                            <TextBlock Text="{Binding Key}" Foreground="Cyan" VerticalAlignment="Center"/>
                                            <oxy:PlotView Height="100" Model="{Binding Value}" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <TextBlock Text="PARAMÈTRES DYNAMIQUES (VOS INDICATEURS)" Style="{StaticResource TitleText}" Margin="15,20,0,0"/>
                <ItemsControl x:Name="DynamicStatsContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AnalyticCard}" Width="350">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" Foreground="Cyan" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <oxy:PlotView Height="200" Model="{Binding Value}" Background="Transparent" PreviewMouseWheel="Control_PreviewMouseWheel"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource AnalyticCard}" BorderBrush="Cyan" BorderThickness="1,1,1,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="💰 SIMULATEUR DE CAPITAL" Style="{StaticResource TitleText}" FontSize="14"/>
                            <TextBlock Text="Saisissez votre capital de départ pour voir l'évolution monétaire réelle." Style="{StaticResource ExplainText}" Margin="0,0,0,15"/>

                            <TextBlock Text="CAPITAL INITIAL" Foreground="Cyan" FontSize="10" FontWeight="Bold"/>
                            <TextBox x:Name="InputCapital" Text="10000" Background="#1f2937" Foreground="White" BorderThickness="0" Padding="8" Margin="0,5,0,15"/>

                            <TextBlock Text="RISQUE PAR TRADE (%)" Foreground="Cyan" FontSize="10" FontWeight="Bold"/>
                            <TextBox x:Name="InputRisk" Text="1" Background="#1f2937" Foreground="White" BorderThickness="0" Padding="8" Margin="0,5,0,15"/>

                            <Button Content="SIMULER" Click="BtnSimulate_Click" Background="Cyan" Foreground="Black" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <oxy:PlotView x:Name="PlotMoneyEquity" Grid.Column="1" Height="250" Background="Transparent"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AnalyticCard}" Background="#1e1b4b" Margin="10,30,10,50">
                    <StackPanel>
                        <TextBlock Text="🏁 CONCLUSION DE L'AUDIT" Style="{StaticResource TitleText}" Foreground="SpringGreen"/>
                        <Separator Background="#312e81" Margin="0,10"/>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="10">
                                <TextBlock Text="PROFIL DE RISQUE" Foreground="Cyan" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtRiskProfile" Text="Calcul en cours..." Foreground="White" TextWrapping="Wrap" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel Margin="10">
                                <TextBlock Text="POTENTIEL DE SCALABILITÉ" Foreground="Cyan" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtScalability" Text="Calcul en cours..." Foreground="White" TextWrapping="Wrap" Margin="0,5"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="RECOMMANDATION FINALE" Foreground="SpringGreen" FontWeight="Bold" Margin="10,15,0,5"/>
                        <TextBlock x:Name="TxtFinalVerdict" Text="..." Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>