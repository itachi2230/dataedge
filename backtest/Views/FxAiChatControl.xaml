<UserControl x:Class="backtest.Views.FxAiChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="400">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête de l'agent (Look Cyberpunk / DataEdge) -->
        <Border Background="{StaticResource CardBg}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" CornerRadius="0,0,12,12" Grid.Row="0" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar avec halo néon cyan -->
                <Ellipse Grid.Column="0" Height="38" Stroke="{StaticResource CyanNeon}" StrokeThickness="1.5" Width="38">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="8" Color="{StaticResource AccentBlueColor}" Opacity="0.5" ShadowDepth="0"/>
                    </Ellipse.Effect>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="pack://application:,,,/Resources/default_user.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="Black" Foreground="{StaticResource CyanNeon}" Text="DATAEDGE AI AGENT"/>
                    <TextBlock FontSize="10" Foreground="Gray" Margin="0,2,0,0" Text="Copilote personnel - données locales sécurisées"/>
                </StackPanel>

                <!-- Petit indicateur de statut ONLINE vert flashy -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="8" FontWeight="Bold" Foreground="#FF00FF03" Margin="0,0,8,0" Text="OUTILS ACTIFS" VerticalAlignment="Center"/>
                    <Border Background="#FF00FF03" CornerRadius="4" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Width="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#FF00FF03" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Liste des messages du Chat -->
        <ScrollViewer Grid.Row="1" Padding="10,5" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer">
            <StackPanel>
                <ItemsControl x:Name="ChatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="{Binding Alignment}" Margin="0,6" MaxWidth="320">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Bulle de message stylisée selon l'expéditeur -->
                                <Border Background="{Binding BubbleColor}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="10" Grid.Row="0" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" Foreground="White" LineHeight="18" Text="{Binding Text}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="8.5" Foreground="Gray" HorizontalAlignment="Right" Margin="0,6,0,0" Text="{Binding Timestamp, StringFormat=HH:mm}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions rapides sous la bulle -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,3,4,0" Opacity="0.75" Orientation="Horizontal">
                                    <!-- Bouton Copier -->
                                    <Button Background="Transparent" BorderThickness="0" Click="BtnCopy_Click" Content="📋 Copier" Cursor="Hand" FontSize="9.5" Foreground="Gray" Margin="0,0,10,0" Tag="{Binding Text}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CyanNeon}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Bouton Renvoyer -->
                                    <Button Background="Transparent" BorderThickness="0" Click="BtnResend_Click" Content="🔄 Relancer" Cursor="Hand" FontSize="9.5" Foreground="Gray" Tag="{Binding Text}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CyanNeon}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Indicateur visuel de chargement de l'IA -->
                <Grid HorizontalAlignment="Left" Margin="8,10" Visibility="Collapsed" x:Name="LoadingIndicator">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Height="16" RenderTransformOrigin="0.5,0.5" Stroke="{StaticResource CyanNeon}" StrokeDashArray="3 1" StrokeThickness="2.5" Width="16">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" x:Name="SpinnerTransform"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Duration="0:0:1.2" From="0" Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" To="360"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock FontSize="11" Foreground="Gray" Grid.Column="1" Margin="8,0,0,0" Text="L'agent réfléchit..." VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Boîte de saisie moderne -->
        <Border Background="{StaticResource CardBg}" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" CornerRadius="12,12,0,0" Grid.Row="2" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,6">
                    <Button Background="#142633" BorderThickness="0" Click="QuickPrompt_Click" Content="Bilan" FontSize="10" Foreground="{StaticResource CyanNeon}" Margin="0,0,5,0" Padding="8,4" Tag="Fais un bilan de mon espace de trading et donne-moi trois priorités."/>
                    <Button Background="#142633" BorderThickness="0" Click="QuickPrompt_Click" Content="Mes règles" FontSize="10" Foreground="{StaticResource CyanNeon}" Margin="0,0,5,0" Padding="8,4" Tag="Résume mes habitudes, mes règles et les écarts récents."/>
                    <Button Background="#142633" BorderThickness="0" Click="QuickPrompt_Click" Content="Analyser" FontSize="10" Foreground="{StaticResource CyanNeon}" Padding="8,4" Tag="Analyse mes trades récents et identifie les biais répétitifs."/>
                </WrapPanel>

                <TextBox FontSize="12.5" Grid.Column="0" Grid.Row="1" KeyDown="TxtInput_KeyDown" MaxHeight="75" Padding="10,8" Style="{StaticResource CyberTextBox}" Tag="Posez votre question à l'IA..." TextWrapping="Wrap" VerticalAlignment="Center" x:Name="TxtInput"/>

                <!-- Bouton d'envoi rond -->
                <Button Background="{StaticResource CyanNeon}" BorderThickness="0" Click="BtnSend_Click" Content="➔" Cursor="Hand" FontSize="16" FontWeight="Bold" Foreground="Black" Grid.Column="1" Grid.Row="1" Height="36" Margin="8,0,0,0" Width="36" x:Name="BtnSend">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="18" x:Name="BtnBorder">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Color="{StaticResource AccentBlueColor}" Opacity="0.4" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Effect" TargetName="BtnBorder">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="12" Color="White" Opacity="0.6" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#11FFFFFF"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>