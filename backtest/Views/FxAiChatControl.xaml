<UserControl x:Class="backtest.Views.FxAiChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:backtest.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="420">

    <UserControl.Resources>
        <!-- Design system « Copilote » : futuriste / pro -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Réduit une largeur mesurée (ActualWidth) de la marge passée en
             paramètre : les tuiles de message et le bandeau de statut suivent
             ainsi la largeur du panneau (430 px normal ou agrandi). -->
        <local:WidthMinusConverter x:Key="WidthMinus"/>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#132435" Offset="0"/>
            <GradientStop Color="#0D1723" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFF" Offset="0"/>
            <GradientStop Color="#00BFFF" Offset="0.55"/>
            <GradientStop Color="#00BFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AiBubbleGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#121E2B" Offset="0"/>
            <GradientStop Color="#0C1520" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UserBubbleGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F2E47" Offset="0"/>
            <GradientStop Color="#0B2033" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="OrbGradient" GradientOrigin="0.35,0.3" Center="0.4,0.35">
            <GradientStop Color="#33E9FF" Offset="0"/>
            <GradientStop Color="#00BFFF" Offset="0.55"/>
            <GradientStop Color="#065B8C" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="SendButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0"/>
            <GradientStop Color="#0090D0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Point de statut pulsé (réflexion / outils en cours) -->
        <Storyboard x:Key="StatusDotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.9" AutoReverse="True"/>
        </Storyboard>

        <!-- Indicateur de frappe : 3 points ondulants -->
        <Storyboard x:Key="Dot1Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.7" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="Dot2Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" BeginTime="0:0:0.18" Duration="0:0:0.7" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="Dot3Anim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" BeginTime="0:0:0.36" Duration="0:0:0.7" AutoReverse="True"/>
        </Storyboard>

        <!-- Chip des prompts rapides (style par défaut : cyan/bleu) -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#0E2233"/>
            <Setter Property="Foreground" Value="#7FD8E8"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="#1C4258" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#123550"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanNeon}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip Bilan : vert émeraude -->
        <Style x:Key="ChipButtonGreen" BasedOn="{StaticResource ChipButton}" TargetType="Button">
            <Setter Property="Background" Value="#0F2E1A"/>
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Setter Property="BorderBrush" Value="#1B7A3A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A4A2A"/>
                    <Setter Property="Foreground" Value="#58D68D"/>
                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chip Semaine : orange ambré -->
        <Style x:Key="ChipButtonOrange" BasedOn="{StaticResource ChipButton}" TargetType="Button">
            <Setter Property="Background" Value="#2E1F0A"/>
            <Setter Property="Foreground" Value="#F39C12"/>
            <Setter Property="BorderBrush" Value="#7A4D1B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A3010"/>
                    <Setter Property="Foreground" Value="#F5B041"/>
                    <Setter Property="BorderBrush" Value="#F39C12"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chip Sentiment : violet magenta -->
        <Style x:Key="ChipButtonPurple" BasedOn="{StaticResource ChipButton}" TargetType="Button">
            <Setter Property="Background" Value="#1E0F2E"/>
            <Setter Property="Foreground" Value="#BB8FCE"/>
            <Setter Property="BorderBrush" Value="#6C3483"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#301A4A"/>
                    <Setter Property="Foreground" Value="#D2B4DE"/>
                    <Setter Property="BorderBrush" Value="#BB8FCE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton fantôme (copier / relancer / fermer) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7A88"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="7,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CyanNeon}"/>
                                <Setter TargetName="GhostBorder" Property="Background" Value="#0E2233"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête du copilote -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="16,13,12,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Orbe IA néon (icône robot vectorielle) — sans effet de blur :
                     coût de rendu nul en mode logiciel -->
                <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource OrbGradient}" Opacity="0.28" Margin="-6"/>
                    <Ellipse Stroke="#3AD9F5" StrokeThickness="1.4"/>
                    <Path Data="M12,2 A2,2 0 0,1 14,4 V5 H10 V4 A2,2 0 0,1 12,2 M5,6 H19 A2,2 0 0,1 21,8 V16 A2,2 0 0,1 19,18 H5 A2,2 0 0,1 3,16 V8 A2,2 0 0,1 5,6 M8,9.6 A1.3,1.3 0 1,0 8,12.2 A1.3,1.3 0 0,0 8,9.6 M16,9.6 A1.3,1.3 0 1,0 16,12.2 A1.3,1.3 0 0,0 16,9.6 M9,14 H15 V15.4 H9 Z"
                          Fill="{StaticResource CyanNeon}" Width="19" Height="19"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="Black" Foreground="White" Text="DATAEDGE "/>
                        <TextBlock FontSize="13" FontWeight="Black" Foreground="{StaticResource CyanNeon}" Text="AI"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="6" Height="6" Fill="#2BFF88" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="5" Color="#2BFF88" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock FontSize="9.5" Foreground="#8FA3B3" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Text="Copilote connecté · vos données restent locales"/>
                    </StackPanel>
                </StackPanel>

                <!-- Effacer / agrandir / fermer (mode panneau flottant) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" FontWeight="Bold" Click="BtnOpenAgentFolder_Click"
                        ToolTip="Ouvrir le dossier des fichiers de l'agent (Documents\DataEdge : documents, rapports PDF/Word, imports)">
                        <!-- Icône Fluent « OpenFolder » (Segoe MDL2 Assets, \uE838) : hérite
                             de la couleur du bouton fantôme (survol cyan automatique). -->
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnClearChat" Style="{StaticResource GhostButton}" FontWeight="Bold"
                        Click="BtnClearChat_Click" ToolTip="Effacer toute la discussion (serveur + agent)">
                        <!-- Icône Fluent « Delete » (Segoe MDL2 Assets, \uE74D) : hérite
                             de la couleur du bouton fantôme (survol cyan automatique). -->
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnExpand" Style="{StaticResource GhostButton}" Content="⤢" FontSize="12" FontWeight="Bold"
                            Margin="3,0,0,0" Click="BtnExpand_Click" ToolTip="Agrandir la discussion"/>
                    <Button Style="{StaticResource GhostButton}" Content="✕" FontSize="12" FontWeight="Bold" Margin="3,0,0,0"
                            Click="BtnClose_Click" ToolTip="Fermer le copilote"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ligne d'accent néon sous l'en-tête -->
        <Rectangle Grid.Row="0" Height="1.4" VerticalAlignment="Bottom" Fill="{StaticResource AccentBarGradient}" Opacity="0.8">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="6" Color="{StaticResource AccentBlueColor}" ShadowDepth="0" Opacity="0.55"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- Messages du chat -->
        <ScrollViewer Grid.Row="1" Padding="12,10" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer">
            <StackPanel>
                <ItemsControl x:Name="ChatItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="{Binding Alignment}" Margin="0,5" Focusable="True"
                                  MaxWidth="{Binding ActualWidth, ElementName=ChatScrollViewer, Converter={StaticResource WidthMinus}, ConverterParameter=50}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Bulle IA / Utilisateur : dégradés distincts -->
                                <Border Grid.Row="0" CornerRadius="14" Padding="12,9" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AiBubbleGradient}"/>
                                            <Setter Property="BorderBrush" Value="#22405A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource UserBubbleGradient}"/>
                                                    <Setter Property="BorderBrush" Value="#1F5C80"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Bandeau de statut live (réflexion + outils, sans
                                             chrono) : visible uniquement pendant le travail
                                             de l'agent, disparaît dès que la réponse finale
                                             commence. -->
                                        <Border Background="#08131C" CornerRadius="8" Padding="9,6" Margin="0,0,0,7"
                                                BorderBrush="#14384F" BorderThickness="1,0,0,0"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource CyanNeon}" VerticalAlignment="Top" Margin="0,4,8,0">
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard Storyboard="{StaticResource StatusDotPulse}"/>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <TextBlock FontStyle="Italic" FontSize="10.5" Foreground="#7FD8E8"
                                                           Text="{Binding StatusText}" TextWrapping="Wrap"
                                                           MaxWidth="{Binding ActualWidth, ElementName=ChatScrollViewer, Converter={StaticResource WidthMinus}, ConverterParameter=110}"
                                                           VerticalAlignment="Center" LineHeight="15"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBox FontSize="12.5" Foreground="#EAF2F8" Text="{Binding Text}" TextWrapping="Wrap" IsReadOnly="True"
                                                 Background="Transparent" BorderThickness="0" Padding="2,0" Margin="0"
                                                 IsTabStop="True" Focusable="True"
                                                 IsInactiveSelectionHighlightEnabled="True"
                                                 SelectionBrush="#33BFFF" SelectionOpacity="0.4"
                                                 PreviewMouseLeftButtonDown="TextBox_SelectFocus"/>
                                        <TextBlock FontSize="8.5" Foreground="#5A6B7A" HorizontalAlignment="Right" Margin="0,5,0,0" Text="{Binding Timestamp, StringFormat=HH:mm}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Actions rapides sous la bulle -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="{Binding Alignment}" Margin="0,2,4,0" Opacity="0.75" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Click="BtnCopy_Click" Content="⧉ Copier" Tag="{Binding Text}"/>
                                    <Button Style="{StaticResource GhostButton}" Click="BtnResend_Click" Content="↺ Relancer" Margin="6,0,0,0" Tag="{Binding Text}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Indicateur de frappe : 3 points + libellé -->
                <StackPanel HorizontalAlignment="Left" Margin="10,8" Orientation="Horizontal" Visibility="Collapsed" x:Name="LoadingIndicator">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanNeon}" VerticalAlignment="Bottom" Margin="0,0,4,2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource Dot1Anim}"/>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanNeon}" VerticalAlignment="Bottom" Margin="0,0,4,2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource Dot2Anim}"/>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource CyanNeon}" VerticalAlignment="Bottom" Margin="0,0,10,2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource Dot3Anim}"/>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock FontSize="11" FontStyle="Italic" Foreground="#7FD8E8" Text="L'agent analyse..." VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Zone de saisie -->
        <Border Grid.Row="2" Background="{StaticResource HeaderGradient}" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="12,10,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Prompts rapides -->
                <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource ChipButtonGreen}" Click="QuickPrompt_Click" Content="✦  Bilan"
                            Tag="Fais un bilan de mon espace de trading et donne-moi trois priorités."
                            ToolTip="Résumé global de vos performances, stratégies et trades, avec 3 priorités d'action."/>
                    <Button Style="{StaticResource ChipButton}" Click="QuickPrompt_Click" Content="◆  Études"
                            Tag="Liste mes études et résume le contenu principal de la plus récente."
                            ToolTip="Lister vos études/notes et résumer leur contenu."/>
                    <Button Style="{StaticResource ChipButtonOrange}" Click="QuickPrompt_Click" Content="◷  Semaine"
                            Tag="Planifie ma semaine de trading. Étapes : 1) appelle l'outil de calendrier pour le mois en cours, 2) cherche sur le web les news et le calendrier économique de la semaine (banques centrales, données macro), 3) crée ou complète la note de la semaine dans la section Weeks : récapitulatif jour par jour, niveaux d'impact en couleur (rouge = fort, orange = moyen) et plan d'action clair. Sois concret et va droit au but."
                            ToolTip="Planifier la semaine : calendrier du mois, news et calendrier économique, puis création/mise à jour de la note hebdo dans Weeks."/>
                    <Button Style="{StaticResource ChipButton}" Click="QuickPrompt_Click" Content="◆  Analyser"
                            Tag="Analyse mes trades récents et identifie les biais répétitifs."
                            ToolTip="Analyser vos derniers trades et repérer les biais ou erreurs récurrentes."/>
                    <Button Style="{StaticResource ChipButton}" Click="QuickPrompt_Click" Content="◆  Stratégies"
                            Tag="Présente mes stratégies avec leurs statistiques et pointe 2 axes d'amélioration concrets."
                            ToolTip="Vue d'ensemble de vos stratégies et leurs statistiques, avec des axes d'amélioration."/>
                    <Button Style="{StaticResource ChipButton}" Click="QuickPrompt_Click" Content="◆  Journal"
                            Tag="Analyse mon journal de trading récent : quels setups sont rentables, lesquels font perdre de l'argent ?"
                            ToolTip="Comprendre quels setups de votre journal sont rentables et lesquels font perdre de l'argent."/>
                    <Button Style="{StaticResource ChipButton}" Click="QuickPrompt_Click" Content="◆  Règles"
                            Tag="Résume mes règles de trading et mes objectifs, puis propose 3 améliorations concrètes."
                            ToolTip="Revoir vos règles de trading et objectifs, avec des améliorations concrètes."/>
                    <Button Style="{StaticResource ChipButtonPurple}" Click="QuickPrompt_Click" Content="◉  Sentiment"
                            Tag="Analyse approfondie du sentiment de marché : 1) Récupère les cotations en direct des paires majeures (EURUSD, GBPUSD, USDJPY, XAUUSD), 2) Consulte le FedWatch pour le contexte de taux, 3) Récupère le sentiment retail MyFxBook, 4) Consulte le calendrier économique de la semaine, 5) Cherche les actualités récentes sur les marchés, 6) Synthèse : tendances, positions extrêmes, événements à risque et interprétation contrariante."
                            ToolTip="Analyse complète du sentiment de marché : cotations, FedWatch, retail, calendrier, actualités et synthèse."/>
                </WrapPanel>

                <!-- Pièce jointe en attente d'envoi (chip) -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" x:Name="AttachPanel" Visibility="Collapsed"
                        Background="#0D2338" BorderBrush="#1F4A66" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📎" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AttachName" Grid.Column="1" FontSize="11" Foreground="#9FD8EA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnRemoveAttachment" Grid.Column="2" Click="BtnRemoveAttachment_Click" Content="✕" FontSize="10"
                                Background="Transparent" Foreground="#5A6B7A" BorderThickness="0" Cursor="Hand" Padding="6,0"
                                ToolTip="Retirer la pièce jointe"/>
                    </Grid>
                </Border>

                <!-- Saisie avec halo au focus + bouton pièce jointe 📎 -->
                <Border Grid.Column="0" Grid.Row="2" CornerRadius="12" Background="#0A141F" BorderBrush="#1C4258" BorderThickness="1" x:Name="InputBorder">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInput" Grid.Column="0" FontSize="12.5" KeyDown="TxtInput_KeyDown" MaxHeight="200" Padding="11,8"
                                 Background="Transparent" BorderThickness="0" Foreground="#EAF2F8" CaretBrush="{StaticResource CyanNeon}"
                                 Tag="Posez votre question à l'IA..." TextWrapping="Wrap" VerticalContentAlignment="Center"
                                 VerticalScrollBarVisibility="Auto" TextChanged="TxtInput_TextChanged"/>
                        <Button x:Name="BtnAttach" Grid.Column="1" Click="BtnAttach_Click" Margin="0,0,9,0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"
                                ToolTip="Joindre un fichier (txt, json, md, csv, pdf, xlsx, docx). Il est copié dans Documents\DataEdge\Imports puis lu localement par l'agent."
                                Content="📎"/>
                    </Grid>
                </Border>

                <!-- Avertissement texte très long -->
                <TextBlock x:Name="InputHint" Grid.Row="3" Grid.ColumnSpan="2" Text="" FontSize="10" Foreground="#E8B34B"
                           Margin="4,4,4,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- Bouton d'envoi : disque gradient + halo -->
                <Button Background="{StaticResource SendButtonGradient}" BorderThickness="0" Click="BtnSend_Click" Content="➤"
                        Cursor="Hand" FontSize="15" FontWeight="Bold" Foreground="#04222F" Grid.Column="1" Grid.Row="1"
                        Height="38" Margin="9,0,0,0" Width="38" x:Name="BtnSend" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="19" x:Name="BtnBorder">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" Color="{StaticResource AccentBlueColor}" Opacity="0.45" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource CyanNeon}"/>
                                                <Setter Property="Effect" TargetName="BtnBorder">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14" Color="{StaticResource AccentBlueColor}" Opacity="0.8" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#11FFFFFF"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="Effect" TargetName="BtnBorder">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Bouton STOP (style Gemini) : remplace le bouton d'envoi pendant
                     la génération. Un clic interrompt la réflexion / la réponse. -->
                <Button Background="#D63B3B" BorderThickness="0" Click="BtnStop_Click" Cursor="Hand"
                        Grid.Column="1" Grid.Row="1" Height="38" Margin="9,0,0,0" Width="38"
                        x:Name="BtnStop" VerticalAlignment="Bottom" Visibility="Collapsed"
                        ToolTip="Arrêter la génération">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="19" x:Name="StopBorder">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF5B5B"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#B02828"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                    <!-- Carré d'arrêt classique (disque rouge + carré blanc) -->
                    <Path Data="M2,2 L10,2 L10,10 L2,10 Z" Fill="White" Width="12" Height="12"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
</Border>
    </Grid>
</UserControl>