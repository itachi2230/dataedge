<Window x:Class="backtest.addStrategieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Ajouter une Stratégie" Height="720" Width="500" 
        Background="#0A0A12" WindowStyle="None" AllowsTransparency="True" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="NeonPulseAnimation">
            <DoubleAnimation Storyboard.TargetName="OuterRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="InnerRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="ModernField" TargetType="TextBox">
            <Setter Property="Background" Value="#121220"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#252540"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource NeonPulseAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="15">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="CRÉER" FontSize="10" Foreground="{StaticResource AccentBlue}" />
                    <TextBlock Text="STRATÉGIE" FontSize="22" FontWeight="Black" Foreground="White"/>
                </StackPanel>

                <Grid HorizontalAlignment="Right" Width="50" Height="50">
                    <Ellipse Stroke="{StaticResource AccentBlue}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OuterRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Stroke="{StaticResource NeonPink}" StrokeThickness="3" Margin="8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="InnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="GlowEffect"  BlurRadius="15" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="CONFIGURATION GÉNÉRALE" FontSize="10" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="NOM DE LA STRATÉGIE" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="StrategieNom" Style="{StaticResource ModernField}" FontSize="14" Height="35" Margin="0,0,0,15"/>

                    <TextBlock Text="DESCRIPTION / RÈGLES" FontSize="9" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox x:Name="descriptionTextbox" Height="80" Style="{StaticResource ModernField}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <Border Background="#121225" CornerRadius="10" Padding="15" Margin="0,0,0,20" BorderBrush="#252540" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="STRUCTURE DES TRADES" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" FontSize="11"/>
                            <TextBlock Text="Les champs suivants seront inclus automatiquement :" FontSize="10" Foreground="Gray" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="Date/Heure" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="Paire" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="Type (Buy/Sell)" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="Résultat" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="RR" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                                <Border Background="#1A1A35" CornerRadius="4" Padding="6,3" Margin="0,0,5,5">
                                    <TextBlock Text="Screenshots" FontSize="9" Foreground="#8080FF"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CHAMPS PERSONNALISÉS (CONFLUENCES)" FontSize="10" Foreground="{StaticResource NeonPink}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Ajoutez ici les critères spécifiques à cette stratégie (ex: Trend, RSI, Zone...)" FontSize="9" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <StackPanel x:Name="CustomFieldsPanel"/>

                    <Button Click="AddCustomField_Click" Margin="0,10" Background="Transparent" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" Foreground="White" Height="35">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" Margin="0,0,10,0" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="AJOUTER UN CRITÈRE" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,20,0,0">
                <Button Content="ANNULER" Click="Cancel_Click" Margin="0,0,10,0" Height="40" Background="#1A1A2E" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="ENREGISTRER" Click="SaveStrategie_Click" Height="40" Background="{StaticResource AccentBlue}" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>