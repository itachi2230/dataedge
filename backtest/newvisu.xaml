<Window x:Class="backtest.newvisu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:backtest"
        Title="Aperçu Image" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Opacity="0">
    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" 
                             Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="#44000000" MouseLeftButtonDown="ExternalGrid_MouseLeftButtonDown">

        <Border x:Name="VisualContainer" 
                Style="{StaticResource CardStyle}" 
                BorderBrush="{StaticResource NeonPink}"
                BorderThickness="0,1,0,0" 
                Margin="300,200"
                MouseLeftButtonDown="VisualContainer_MouseLeftButtonDown">

            <local:TradeVisualizerControl x:Name="TradeVisualizer"  />
        </Border>
    </Grid>
</Window>