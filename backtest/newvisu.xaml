<Window x:Class="backtest.newvisu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:backtest"
        Title="Aperçu Image" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" 
                             Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="#BB000000" MouseLeftButtonDown="ExternalGrid_MouseLeftButtonDown">

        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" IsHitTestVisible="False">
            <TextBlock Text="DOUBLE-CLIQUEZ SUR UNE IMAGE POUR L'AGRANDIR" 
                       Foreground="{StaticResource AccentBlue}" 
                       FontSize="11" FontWeight="Bold" 
                       HorizontalAlignment="Center" Opacity="0.8"/>
            <TextBlock Text="CLIQUEZ À L'EXTÉRIEUR POUR FERMER" 
                       Foreground="Gray" 
                       FontSize="9" 
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <Border x:Name="VisualContainer" 
                Style="{StaticResource CardStyle}" 
                BorderBrush="{StaticResource NeonPink}"
                BorderThickness="0,1,0,0" 
                Margin="300,200"
                Background="#0A0A12"
                MouseLeftButtonDown="VisualContainer_MouseLeftButtonDown">

            <local:TradeVisualizerControl x:Name="TradeVisualizer" />
        </Border>
    </Grid>
</Window>